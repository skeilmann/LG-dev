{%- comment -%}
  Mobile Catalog Drawer Component

  Renders a bottom sheet drawer for mobile catalog navigation.
  Slides up from bottom with backdrop overlay and supports
  nested accordions for categories and subcategories.

  Usage:
  {% render 'mobile-catalog-drawer', section: section, full_menus: full_menus %}
  full_menus: render the catalog list (menu fetch); otherwise an empty placeholder

  Features:
  - Bottom sheet slide-up animation
  - Backdrop overlay with click-to-close
  - Nested accordion structure
  - Lazy image loading
  - Swipe down gesture support
  - Full accessibility with ARIA
{%- endcomment -%}

{%- liquid
  # Get the catalog menu from section settings
  assign catalog_menu_handle = section.settings.mobile_catalog_menu | default: 'main-menu'
  assign catalog_menu = linklists[catalog_menu_handle]

  # If the selected menu is empty, try multiple fallbacks
  if catalog_menu == blank
    assign catalog_menu = linklists['main-menu']

    # If main-menu is also blank, try other common menu names
    if catalog_menu == blank
      assign catalog_menu = linklists['catalog-menu']
    endif

    # If still blank, try left-menu
    if catalog_menu == blank
      assign catalog_menu = linklists['left-menu']
    endif

    # If still blank, try any available menu
    if catalog_menu == blank
      for menu in linklists
        if menu.links.size > 0
          assign catalog_menu = menu
          break
        endif
      endfor
    endif
  endif

  # Use the selected catalog menu
  assign menu_to_use = catalog_menu
-%}

<div
  id="mobile-catalog-drawer"
  class="mobile-catalog-drawer"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  aria-label="{{ 'sections.header.mobile_bottom_nav.catalog' | t }}"
  data-drawer-content
>
  {%- comment -%} Backdrop overlay {%- endcomment -%}
  <div class="mobile-catalog-drawer__backdrop" data-drawer-backdrop></div>

  {%- comment -%} Drawer content container {%- endcomment -%}
  <div class="mobile-catalog-drawer__content">
    {%- comment -%} Handle bar for swipe gesture indication {%- endcomment -%}
    <div class="mobile-catalog-drawer__handle" data-drawer-handle>
      <span class="visually-hidden">{{ 'sections.header.mobile_bottom_nav.swipe_down' | t }}</span>
    </div>

    {%- comment -%} Drawer header {%- endcomment -%}
    <div class="mobile-catalog-drawer__header">
      <h2 class="mobile-catalog-drawer__title">{{ 'sections.header.mobile_bottom_nav.catalog' | t }}</h2>
      <button
        type="button"
        class="mobile-catalog-drawer__close"
        data-drawer-close
        aria-label="{{ 'sections.header.mobile_bottom_nav.close_drawer' | t }}"
      >
        <span class="svg-wrapper">{{ 'icon-close.svg' | inline_asset_content }}</span>
      </button>
    </div>

    {%- comment -%} Drawer body with catalog content {%- endcomment -%}
    <div class="mobile-catalog-drawer__body">
      {%- if menu_to_use != blank -%}
        {%- comment -%}
          Only rendered for the menu fetch (full_menus); normal pages get an empty
          placeholder that mobile-bottom-nav.js fills on first open.
        {%- endcomment -%}
        {%- if full_menus -%}
        {%- capture icon_expand -%}
          <span class="catalog-list__icon catalog-list__icon--expand" aria-hidden="true">
            <svg width="12" height="8" viewBox="0 0 12 8" fill="none" focusable="false"><path d="M1 1.5L6 6.5L11 1.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        {%- endcapture -%}
        {%- capture icon_go -%}
          <span class="catalog-list__icon catalog-list__icon--go" aria-hidden="true">
            <svg width="8" height="12" viewBox="0 0 8 12" fill="none" focusable="false"><path d="M1.5 1L6.5 6L1.5 11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        {%- endcapture -%}
        {%- assign all_label = 'sections.header.mobile_bottom_nav.all_products' | t -%}
        <nav
          class="mobile-catalog-drawer__nav"
          aria-label="{{ 'sections.header.mobile_bottom_nav.catalog' | t }}"
        >
          <ul class="catalog-list catalog-list--level-1" role="list">
            {%- for link in menu_to_use.links -%}
              <li class="catalog-list__item">
                {%- if link.links != blank -%}
                  <details class="catalog-list__group" data-category-handle="{{ link.handle }}">
                    <summary class="catalog-list__row catalog-list__row--level-1">
                      <span class="catalog-list__label">{{ link.title | escape }}</span>
                      {{- icon_expand -}}
                    </summary>
                    <ul class="catalog-list catalog-list--level-2" role="list">
                      <li class="catalog-list__item">
                        <a
                          href="{{ link.url }}"
                          class="catalog-list__row catalog-list__row--level-2 catalog-list__row--all"
                          aria-label="{{ all_label }}: {{ link.title | escape }}"
                          {% if link.current %}aria-current="page"{% endif %}
                        >
                          <span class="catalog-list__label">{{ all_label }}</span>
                          {{- icon_go -}}
                        </a>
                      </li>
                      {%- for sublink in link.links -%}
                        <li class="catalog-list__item">
                          {%- if sublink.links != blank -%}
                            <details class="catalog-list__group" data-subcategory-handle="{{ sublink.handle }}">
                              <summary class="catalog-list__row catalog-list__row--level-2">
                                <span class="catalog-list__label">{{ sublink.title | escape }}</span>
                                {{- icon_expand -}}
                              </summary>
                              <ul class="catalog-list catalog-list--level-3" role="list">
                                <li class="catalog-list__item">
                                  <a
                                    href="{{ sublink.url }}"
                                    class="catalog-list__row catalog-list__row--level-3 catalog-list__row--all"
                                    aria-label="{{ all_label }}: {{ sublink.title | escape }}"
                                    {% if sublink.current %}aria-current="page"{% endif %}
                                  >
                                    <span class="catalog-list__label">{{ all_label }}</span>
                                    {{- icon_go -}}
                                  </a>
                                </li>
                                {%- for sub_sublink in sublink.links -%}
                                  <li class="catalog-list__item">
                                    <a
                                      href="{{ sub_sublink.url }}"
                                      class="catalog-list__row catalog-list__row--level-3"
                                      data-collection-handle="{{ sub_sublink.handle }}"
                                      {% if sub_sublink.current %}aria-current="page"{% endif %}
                                    >
                                      <span class="catalog-list__label">{{ sub_sublink.title | escape }}</span>
                                      {{- icon_go -}}
                                    </a>
                                  </li>
                                {%- endfor -%}
                              </ul>
                            </details>
                          {%- else -%}
                            <a
                              href="{{ sublink.url }}"
                              class="catalog-list__row catalog-list__row--level-2"
                              data-collection-handle="{{ sublink.handle }}"
                              {% if sublink.current %}aria-current="page"{% endif %}
                            >
                              <span class="catalog-list__label">{{ sublink.title | escape }}</span>
                              {{- icon_go -}}
                            </a>
                          {%- endif -%}
                        </li>
                      {%- endfor -%}
                    </ul>
                  </details>
                {%- else -%}
                  <a
                    href="{{ link.url }}"
                    class="catalog-list__row catalog-list__row--level-1"
                    {% if link.current %}aria-current="page"{% endif %}
                  >
                    <span class="catalog-list__label">{{ link.title | escape }}</span>
                    {{- icon_go -}}
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </nav>
        {%- else -%}
          <div class="mobile-catalog-drawer__nav mobile-catalog-drawer__nav--pending" data-catalog-pending aria-busy="true"></div>
        {%- endif -%}
      {%- else -%}
        {%- comment -%} Fallback when no menu is configured {%- endcomment -%}
        <div class="mobile-catalog-drawer__empty">
          <p class="mobile-catalog-drawer__empty-text">
            {{ 'sections.header.mobile_bottom_nav.no_menu' | t }}
          </p>
          <a
            href="{{ routes.collections_url }}"
            class="mobile-catalog-drawer__empty-link"
          >
            {{ 'sections.header.mobile_bottom_nav.view_all_collections' | t }}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>
