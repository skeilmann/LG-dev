{%- comment -%}
  Loyalty Cart Widget
  Points balance and "redeem" button in the cart drawer and on the cart page.
  - Logged-in customers: filled by loyalty-handler.js (hidden until loaded).
  - Guests: a short invitation to log in or register (no server call).
  Renders nothing when the "VEV app" theme settings are off.

  Usage: {% render 'loyalty-cart-widget' %}
  Dependencies: assets/loyalty-handler.js, assets/component-loyalty.css
{%- endcomment -%}
{%- if settings.loyalty_widgets_enabled and settings.vev_api_url != blank -%}
  {%- if customer -%}
    <div class="loyalty-cart-widget" data-customer hidden></div>
  {%- else -%}
    <div class="loyalty-cart-widget">
      <p class="loyalty-guest-message">
        <a href="{{ routes.account_login_url }}">{{ 'customer.log_in' | t }}</a>
        {{ 'customer.loyalty.or' | t }}
        <a href="{{ routes.account_register_url }}">{{ 'customer.register.title' | t | downcase }}</a>
        {{ 'customer.loyalty.to_earn' | t }}
      </p>
    </div>
  {%- endif -%}
{%- endif -%}
