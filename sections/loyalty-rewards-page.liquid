{%- comment -%}
  Loyalty Rewards Page Section (templates/page.rewards.json)
  - Logged-in customers: balance, tier, redeem button and recent activity,
    drawn by assets/loyalty-handler.js into [data-loyalty-rewards].
  - Guests: how the program works and the tiers (values below match the
    server defaults; update them if shop metafield custom.loyalty_config changes).
  Dependencies: assets/loyalty-handler.js, assets/component-loyalty.css
{%- endcomment -%}

{{ 'component-loyalty.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading = section.settings.title
  if heading == blank
    assign heading = 'customer.loyalty.title' | t
  endif
  assign points_required = 100
  assign discount_value = 5
  assign silver_rate = '1,5'
  if request.locale.iso_code == 'en'
    assign silver_rate = '1.5'
  endif
-%}

<div class="loyalty-rewards-page page-width section-{{ section.id }}-padding">
  <div class="loyalty-rewards-header">
    <h1 class="loyalty-rewards-title">{{ heading | escape }}</h1>
    {%- if section.settings.subtitle != blank -%}
      <p class="loyalty-rewards-subtitle">{{ section.settings.subtitle | escape }}</p>
    {%- endif -%}
  </div>

  {%- if customer and settings.vev_api_url != blank -%}
    <div class="loyalty-rewards-content" data-loyalty-rewards>
      <p class="loyalty-loading">{{ 'customer.loyalty.loading' | t }}</p>
    </div>
  {%- elsif customer -%}
    <p class="loyalty-unavailable">{{ 'customer.loyalty.unavailable' | t }}</p>
  {%- else -%}
    <div class="loyalty-rewards-guest">
      <div class="loyalty-guest-card">
        <h2>{{ 'customer.loyalty.join_title' | t }}</h2>
        <p>{{ 'customer.loyalty.join_description' | t }}</p>

        <div class="loyalty-tiers-preview">
          <h3>{{ 'customer.loyalty.tiers_title' | t }}</h3>
          <div class="loyalty-tiers-grid">
            <div class="loyalty-tier-card loyalty-tier-bronze">
              <span class="loyalty-tier-icon" aria-hidden="true">🥉</span>
              <h4>{{ 'customer.loyalty.tier_bronze' | t }}</h4>
              <p>{{ 'customer.loyalty.points_per_mdl' | t: rate: '1' }}</p>
              <span class="loyalty-tier-threshold">{{ 'customer.loyalty.from_amount' | t: amount: '0' }}</span>
            </div>
            <div class="loyalty-tier-card loyalty-tier-silver">
              <span class="loyalty-tier-icon" aria-hidden="true">🥈</span>
              <h4>{{ 'customer.loyalty.tier_silver' | t }}</h4>
              <p>{{ 'customer.loyalty.points_per_mdl' | t: rate: silver_rate }}</p>
              <span class="loyalty-tier-threshold">{{ 'customer.loyalty.from_amount' | t: amount: '500' }}</span>
            </div>
            <div class="loyalty-tier-card loyalty-tier-gold">
              <span class="loyalty-tier-icon" aria-hidden="true">🥇</span>
              <h4>{{ 'customer.loyalty.tier_gold' | t }}</h4>
              <p>{{ 'customer.loyalty.points_per_mdl' | t: rate: '2' }}</p>
              <span class="loyalty-tier-threshold">{{ 'customer.loyalty.from_amount' | t: amount: '2 000' }}</span>
            </div>
          </div>
        </div>

        <div class="loyalty-how-it-works">
          <h3>{{ 'customer.loyalty.how_it_works' | t }}</h3>
          <ol class="loyalty-steps list-unstyled" role="list">
            <li class="loyalty-step">
              <span class="loyalty-step-number" aria-hidden="true">1</span>
              <h4>{{ 'customer.loyalty.step_shop_title' | t }}</h4>
              <p>{{ 'customer.loyalty.step_shop_text' | t }}</p>
            </li>
            <li class="loyalty-step">
              <span class="loyalty-step-number" aria-hidden="true">2</span>
              <h4>{{ 'customer.loyalty.step_earn_title' | t }}</h4>
              <p>{{ 'customer.loyalty.step_earn_text' | t }}</p>
            </li>
            <li class="loyalty-step">
              <span class="loyalty-step-number" aria-hidden="true">3</span>
              <h4>{{ 'customer.loyalty.step_redeem_title' | t }}</h4>
              <p>{{ 'customer.loyalty.step_redeem_text' | t: points: points_required, value: discount_value }}</p>
            </li>
          </ol>
        </div>

        <div class="loyalty-cta-buttons">
          <a href="{{ routes.account_register_url }}" class="button">{{ 'customer.register.title' | t }}</a>
          <a href="{{ routes.account_login_url }}" class="button button--secondary">{{ 'customer.log_in' | t }}</a>
        </div>
      </div>
    </div>
  {%- endif -%}
</div>

<style>
  .loyalty-rewards-page {
    padding-top: calc(var(--page-width-margin) * 2);
    padding-bottom: calc(var(--page-width-margin) * 2);
  }

  .loyalty-rewards-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .loyalty-rewards-title {
    font-size: 3.6rem;
    margin: 0 0 1rem;
  }

  .loyalty-rewards-subtitle {
    font-size: 1.6rem;
    color: rgba(var(--color-foreground), 0.7);
    margin: 0;
  }

  /* Dashboard */
  .loyalty-dashboard {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(30rem, 1fr));
    gap: 2rem;
    margin-bottom: 4rem;
  }

  .loyalty-balance-card,
  .loyalty-tier-card-current {
    padding: 2.5rem;
    background-color: rgb(var(--color-background));
    border: 1px solid rgba(var(--color-foreground), 0.1);
    border-radius: var(--buttons-radius, 0);
  }

  .loyalty-balance-main {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .loyalty-balance-icon {
    font-size: 4rem;
  }

  .loyalty-balance-info {
    display: flex;
    flex-direction: column;
  }

  .loyalty-balance-points {
    font-size: 3.6rem;
    font-weight: 700;
    line-height: 1.1;
  }

  .loyalty-balance-label {
    font-size: 1.4rem;
    color: rgba(var(--color-foreground), 0.6);
  }

  .loyalty-redeem-info {
    font-size: 1.3rem;
    color: rgba(var(--color-foreground), 0.7);
    margin: 0;
  }

  /* Tier Card */
  .loyalty-tier-card-current h3 {
    font-size: 1.6rem;
    margin: 0 0 1.5rem;
    color: rgba(var(--color-foreground), 0.7);
  }

  .loyalty-current-tier {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .loyalty-tier-badge {
    font-size: 2.4rem;
    font-weight: 700;
  }

  .loyalty-tier-rate {
    font-size: 1.4rem;
    color: rgba(var(--color-foreground), 0.6);
  }

  .loyalty-tier-bronze .loyalty-tier-badge { color: #cd7f32; }
  .loyalty-tier-silver .loyalty-tier-badge { color: #a8a8a8; }
  .loyalty-tier-gold .loyalty-tier-badge { color: #ffd700; }

  /* History */
  .loyalty-history-section {
    background-color: rgb(var(--color-background));
    border: 1px solid rgba(var(--color-foreground), 0.1);
    border-radius: var(--buttons-radius, 0);
    padding: 2.5rem;
  }

  .loyalty-history-section h3 {
    font-size: 1.8rem;
    margin: 0 0 2rem;
  }

  .loyalty-history-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .loyalty-history-item {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.5rem;
    background-color: rgba(var(--color-foreground), 0.02);
    border-radius: var(--buttons-radius, 0);
  }

  .loyalty-history-icon {
    font-size: 2rem;
  }

  .loyalty-history-details {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .loyalty-history-action {
    font-size: 1.4rem;
    font-weight: 500;
  }

  .loyalty-history-date {
    font-size: 1.2rem;
    color: rgba(var(--color-foreground), 0.5);
  }

  .loyalty-history-points {
    font-size: 1.6rem;
    font-weight: 600;
  }

  .loyalty-history-points.positive { color: #28a745; }
  .loyalty-history-points.negative { color: #dc3545; }

  .loyalty-no-history {
    text-align: center;
    color: rgba(var(--color-foreground), 0.5);
    font-style: italic;
  }

  /* Guest View */
  .loyalty-rewards-guest {
    max-width: 80rem;
    margin: 0 auto;
  }

  .loyalty-guest-card {
    text-align: center;
    padding: 4rem;
    background-color: rgb(var(--color-background));
    border: 1px solid rgba(var(--color-foreground), 0.1);
    border-radius: var(--buttons-radius, 0);
  }

  .loyalty-guest-card h2 {
    font-size: 2.4rem;
    margin: 0 0 1rem;
  }

  .loyalty-guest-card > p {
    font-size: 1.6rem;
    color: rgba(var(--color-foreground), 0.7);
    margin: 0 0 3rem;
  }

  .loyalty-tiers-preview,
  .loyalty-how-it-works {
    margin-bottom: 3rem;
  }

  .loyalty-tiers-preview h3,
  .loyalty-how-it-works h3 {
    font-size: 1.8rem;
    margin: 0 0 2rem;
  }

  .loyalty-tiers-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .loyalty-tier-card {
    padding: 2rem;
    border: 1px solid rgba(var(--color-foreground), 0.1);
    border-radius: var(--buttons-radius, 0);
  }

  .loyalty-tier-card .loyalty-tier-icon {
    font-size: 3rem;
    display: block;
    margin-bottom: 1rem;
  }

  .loyalty-tier-card h4 {
    font-size: 1.6rem;
    margin: 0 0 0.5rem;
  }

  .loyalty-tier-card p {
    font-size: 1.3rem;
    margin: 0 0 0.5rem;
    color: rgba(var(--color-foreground), 0.7);
  }

  .loyalty-tier-threshold {
    font-size: 1.2rem;
    color: rgba(var(--color-foreground), 0.5);
  }

  .loyalty-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .loyalty-step {
    text-align: center;
  }

  .loyalty-step-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    background-color: rgb(var(--color-button));
    color: rgb(var(--color-button-text));
    border-radius: 50%;
    font-size: 1.8rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .loyalty-step h4 {
    font-size: 1.6rem;
    margin: 0 0 0.5rem;
  }

  .loyalty-step p {
    font-size: 1.3rem;
    color: rgba(var(--color-foreground), 0.7);
    margin: 0;
  }

  .loyalty-cta-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
  }

  /* Mobile */
  @media screen and (max-width: 749px) {
    .loyalty-rewards-title {
      font-size: 2.8rem;
    }

    .loyalty-dashboard {
      grid-template-columns: 1fr;
    }

    .loyalty-tiers-grid,
    .loyalty-steps {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .loyalty-cta-buttons {
      flex-direction: column;
    }

    .loyalty-guest-card {
      padding: 2rem;
    }
  }
</style>

{% schema %}
{
  "name": "Loyalty Rewards Page",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "info": "Leave empty to use the translated title"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Loyalty Rewards Page"
    }
  ]
}
{% endschema %}
