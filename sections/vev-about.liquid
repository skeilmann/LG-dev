{%- comment -%}
  vev-about.liquid
  "About the shop" block (Figma: VEV.MD Concept → "О МАГАЗИНЕ VEV.MD ☺️").

  - Light grey band with a square photo on the left and heading + text on the right.
  - On mobile the photo sits above the text.
  - Text is rich text, so the merchant can bold words and split paragraphs.

  Dependencies:
  - assets/section-vev-about.css
{%- endcomment -%}
{{ 'section-vev-about.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign heading = section.settings.heading | strip
  assign heading_id = 'VevAboutHeading-' | append: section.id
-%}

<div class="vev-about section-{{ section.id }}-padding">
  <div
    class="vev-about__inner{% if section.settings.image == blank %} vev-about__inner--no-image{% endif %}"
    {% if heading != blank %}
      aria-labelledby="{{ heading_id }}"
      role="region"
    {% endif %}
  >
    {%- if section.settings.image != blank -%}
      <div class="vev-about__media">
        {%- assign image_alt = section.settings.image.alt | default: heading | escape -%}
        {{
          section.settings.image
          | image_url: width: 1400
          | image_tag:
            loading: 'lazy',
            sizes: '(min-width: 990px) 39vw, calc(100vw - 3rem)',
            widths: '375, 550, 750, 1000, 1400',
            alt: image_alt,
            class: 'vev-about__image'
        }}
      </div>
    {%- endif -%}

    <div class="vev-about__content">
      {%- if heading != blank -%}
        <h2 id="{{ heading_id }}" class="vev-about__heading">{{ heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="vev-about__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.vev_about.name",
  "tag": "section",
  "class": "section vev-about-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.vev_about.settings.image.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.vev_about.settings.heading.label",
      "default": "О МАГАЗИНЕ VEV.MD ☺️"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.vev_about.settings.text.label",
      "default": "<p><strong>VEV LUX NAILS SHOP</strong> - это все необходимые Вам товары для маникюра и дизайна ногтей в Молдове, собранные в одном месте.</p>"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 88
    }
  ],
  "presets": [
    {
      "name": "t:sections.vev_about.presets.name"
    }
  ]
}
{% endschema %}
