{%- style -%}
   {% if template == 'product' and section.settings.enable_product_page  %}
     .breadcrumbs{
       display: block;
     }
     {% else %}
     .breadcrumbs{
       display: none;
     }
   {% endif %}

  {% if section.settings.enable_complete_site %}
    .breadcrumbs{
      display: block;
    }
    {% endif %}

  {% if template == 'collection' and section.settings.enable_collection_page  %}
     .breadcrumbs{
       display: block;
     }
   {% endif %}


       :root  {
         --svg_fill: {{ section.settings.breadcrumb_text_color}}
         ;
       }

       .breadcrumbs {
         padding: 55px 1.5rem;
         color: {{ section.settings.breadcrumb_text_color }};
         font-family: "Graphik LCG", sans-serif;
         font-size: 18px;
         font-weight: 500;
         background-color: {{ section.settings.breadcrumb_bg_color }};
       }

       @media screen and (min-width: 750px) {
         .breadcrumbs {
           padding: 55px 5rem;
         }
       }

       .breadcrumbs li {
         display: inline-block;
       }

       .breadcrumbs a {
         text-decoration: none;
         font-size: inherit;
         font-weight: inherit;
         color: inherit;
       }


     {%- if section.settings.breadcrumb_accent_color_bool -%}
         .breadcrumbs a:last-of-type {
           color: {{ section.settings.breadcrumb_accent_color }}
            !important;
         }
       {%- endif -%}


       .breadcrumb-delimeter:not(:last-child):after {
         {%- case section.settings.breadcrumb_delimeter -%}
           {%- when "angle_right" -%}
           content: "›";
           font-size: 18px;
           {%- when "slash" -%}
           content: "/";
           font-size: 16px;
           {%- when "arrow_right" -%}
           content: "➤";
           font-size: 15px;
           {%- when "squiggle_arrow" -%}
           content: "\27FF";
           font-size: 25px;
           {%- when "right_long" -%}
           content: "\279E";
           font-size: 18px;
           transform: translateY(5%);
           {%- when "double_right" -%}
           content: "\00BB";
           font-size: 20px;
           {%- when "diamond_arrow_head" -%}
           content: "⤞";
           font-size: 25px;
           transform: translateY(5%);
           {%- when "heavy_angle_right" -%}
           content: "\276F";
           font-size: 18px;
           transform: translateY(5%);
         {%- else -%}

         {%- endcase -%}
         display: inline-block;
         margin-left: 1.25rem;
         margin-right: 1.25rem;
         speak: none;
       }

       .breadcrumbs [aria-current="page"] {
         color: inherit;
         font-weight: inherit;
         text-decoration: none;
       }
{%- endstyle -%}

{%- comment -%}
  The trail is captured so the same links can also be written as BreadcrumbList
  structured data for Google (see the end of this file).
{%- endcomment -%}
{%- capture breadcrumb_trail -%}
  {%- unless template == 'index' or template == 'cart' -%}
    <a href="{{ routes.root_url }}" title="{{ 'sections.breadcrumbs.home' | t }}">{{ 'sections.breadcrumbs.home' | t }}</a>
    {%- case template.name -%}
      {%- when 'article' -%}
        {%- for link in linklists['main-menu'].links -%}
          {%- if link.url == blog.url -%}
            <span class="breadcrumb-delimeter" aria-hidden="true"></span>
            <!-- Breadcrumb Delimeter -->
            {{ link.title | link_to: link.url }}
            {% break %}
          {%- endif -%}
        {%- endfor -%}
        <span class="breadcrumb-delimeter" aria-hidden="true"></span>
        <a href="{{ article.url }}" aria-current="page">{{ article.title }}</a>
      {%- when 'product' -%}
        {%- comment -%}
          Category trail from the natively nested main menu (same menu as the mega
          menu): the deepest item, up to 3 levels, whose URL is one of the product's
          collections, plus its parents. Matching on URLs (not titles) keeps it
          working in every language.
        {%- endcomment -%}
        {%- liquid
          assign product_collection_urls = product.collections | map: 'url'
          assign crumb_depth = 0
          for l1 in linklists['main-menu'].links
            if crumb_depth < 1 and product_collection_urls contains l1.url
              assign crumb_depth = 1
              assign crumb_1 = l1
            endif
            for l2 in l1.links
              if crumb_depth < 2 and product_collection_urls contains l2.url
                assign crumb_depth = 2
                assign crumb_1 = l1
                assign crumb_2 = l2
              endif
              for l3 in l2.links
                if crumb_depth < 3 and product_collection_urls contains l3.url
                  assign crumb_depth = 3
                  assign crumb_1 = l1
                  assign crumb_2 = l2
                  assign crumb_3 = l3
                endif
              endfor
            endfor
            if crumb_depth == 3
              break
            endif
          endfor
        -%}
        {%- if crumb_depth >= 1 -%}
          <span class="breadcrumb-delimeter" aria-hidden="true"></span>
          <a href="{{ crumb_1.url }}">{{ crumb_1.title | escape }}</a>
        {%- endif -%}
        {%- if crumb_depth >= 2 -%}
          <span class="breadcrumb-delimeter" aria-hidden="true"></span>
          <a href="{{ crumb_2.url }}">{{ crumb_2.title | escape }}</a>
        {%- endif -%}
        {%- if crumb_depth >= 3 -%}
          <span class="breadcrumb-delimeter" aria-hidden="true"></span>
          <a href="{{ crumb_3.url }}">{{ crumb_3.title | escape }}</a>
        {%- endif -%}
        <span class="breadcrumb-delimeter" aria-hidden="true"></span>
        <span aria-current="page">{{ product.title | escape }}</span>
      {%- else -%}
        {% for link in linklists['main-menu'].links %}
          {% if link.child_active or link.active %}
            <span class="breadcrumb-delimeter" aria-hidden="true"></span>
            <!-- Breadcrumb delimeter -->
            <a href="{{ link.url }}">
              {{ link.title | escape }}
            </a>
            {% for clink in link.links %}
              {% if clink.child_active or clink.active %}
                <span class="breadcrumb-delimeter" aria-hidden="true"></span>
                <a href="{{ clink.url }}">
                  {{ clink.title | escape }}
                </a>
                {% for gclink in clink.links %}
                  {% if gclink.child_active or gclink.active %}
                    <span class="breadcrumb-delimeter" aria-hidden="true"></span>
                    <a href="{{ gclink.url }}">
                      {{ gclink.title | escape }}
                    </a>
                  {% endif %}
                {%- endfor -%}
              {% endif %}
            {%- endfor -%}
          {% endif %}
        {%- endfor -%}
    {%- endcase -%}
  {%- endunless -%}
{%- endcapture -%}

<nav class="page-width breadcrumbs" aria-label="{{ 'sections.breadcrumbs.label' | t }}">
  {{- breadcrumb_trail -}}
</nav>

{%- comment -%}
  BreadcrumbList structured data, built from the links above so it always matches
  what shoppers see. Only output where the breadcrumbs are visible (Google requires
  structured data to match visible content).
{%- endcomment -%}
{%- liquid
  assign breadcrumbs_visible = section.settings.enable_complete_site
  if template.name == 'product' and section.settings.enable_product_page
    assign breadcrumbs_visible = true
  endif
  if template.name == 'collection' and section.settings.enable_collection_page
    assign breadcrumbs_visible = true
  endif
  assign crumb_links = breadcrumb_trail | split: '<a href="'
-%}
{%- if breadcrumbs_visible and crumb_links.size > 2 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {%- assign position = 0 -%}
        {%- for crumb in crumb_links offset: 1 -%}
          {%- liquid
            assign crumb_url = crumb | split: '"' | first
            assign crumb_name = crumb | split: '</a>' | first | split: '>' | last | strip_html | strip
            if crumb_url contains '://'
              assign crumb_item = crumb_url
            else
              assign crumb_item = request.origin | append: crumb_url
            endif
            assign position = position | plus: 1
          -%}
          {%- unless position == 1 -%},{%- endunless -%}
          {
            "@type": "ListItem",
            "position": {{ position }},
            "name": {{ crumb_name | json }},
            "item": {{ crumb_item | json }}
          }
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Breadcrumb Navigation",
  "settings": [
    {
      "type": "select",
      "id": "breadcrumb_delimeter",
      "label": "Breadcrumb Delimeter Icon",
      "options": [
        {
          "value": "angle_right",
          "label": "Angle Right"
        },
        {
          "value": "slash",
          "label": "Slash"
        },
        {
          "value": "arrow_right",
          "label": "Arrow Right"
        },
        {
          "value": "squiggle_arrow",
          "label": "Squiggle Arrow"
        },
        {
          "value": "right_long",
          "label": "Right Long"
        },
        {
          "value": "double_right",
          "label": "Double Right"
        },
        {
          "value": "diamond_arrow_head",
          "label": "Diamond Arrow Head"
        },
        {
          "value": "heavy_angle_right",
          "label": "Heavy Angle Right"
        }
      ],
      "default": "angle_right"
    },
    {
      "type": "color",
      "id": "breadcrumb_bg_color",
      "label": "Background Color",
      "default": "#fff"
    },
    {
      "type": "color",
      "id": "breadcrumb_text_color",
      "label": "Breadcrumb Color",
      "default": "#000000"
    },
    {
      "type": "checkbox",
      "id": "breadcrumb_accent_color_bool",
      "label": "Enable visited page color link in breadcrumb",
      "default": false
    },
    {
      "type": "color",
      "id": "breadcrumb_accent_color",
      "label": "Visited Page Link Color",
      "default": "#4770db"
    },
    {
      "type": "checkbox",
      "id": "enable_product_page",
      "label": "Enable in Product Page"
    },
    {
      "type": "checkbox",
      "id": "enable_collection_page",
      "label": "Enable in Collection Page"
    },
    {
      "type": "checkbox",
      "id": "enable_complete_site",
      "label": "Enable on Complete Website",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Breadcrumb Navigation"
    }
  ]
}
{% endschema %}
